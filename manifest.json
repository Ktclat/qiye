{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "__MSG_shortName__",
  "version": "0.10.14",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "action": {
    "default_title": "__MSG_savePage__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "favicon"
  ],
  "optional_permissions": [
    "geolocation",
    "bookmarks",
    "history"
  ],
  "host_permissions": [
    "https://picsum.photos/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "commands": {
    "open-local-search": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "__MSG_localSearch__"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
    "sandbox": "sandbox allow-scripts allow-forms allow-downloads; script-src 'unsafe-inline' data: https:; object-src 'none'; child-src 'none'; base-uri 'none'"
  },
  "sandbox": {
    "pages": [
      "widget-sandbox.html"
    ]
  },
  "default_locale": "en",
  "key": ""
}
